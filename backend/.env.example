# ==========================================
# OmniMarket AI - Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas Connection URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.edolatd.mongodb.net/omnimarket_auth_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_for_production
JWT_EXPIRES_IN=24h

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1024

# OpenAI Image Generation API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=dall-e-3

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Meta Facebook Graph API Configuration
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FB_PAGE_ID=your_facebook_page_id_here
FB_GRAPH_API_VERSION=v18.0
FB_GRAPH_BASE_URL=https://graph.facebook.com
